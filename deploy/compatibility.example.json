{
  "schemaVersion": 2,
  "release": "v0.0.0",
  "contracts": {
    "printAgentApi": "v1",
    "printHubApi": "v1",
    "printerFleetApi": "v1",
    "thingdexApi": "v1"
  },
  "hardwareAcceptance": {
    "schemaVersion": 1,
    "file": "hardware-acceptance.json",
    "sha256": "${HARDWARE_ACCEPTANCE_SHA256}",
    "supportedTransports": ["raw_tcp"],
    "testedAt": "${HARDWARE_TESTED_AT}",
    "reviewedAt": "${HARDWARE_REVIEWED_AT}"
  },
  "components": {
    "ippGateway": {
      "image": "${PRINTHUB_IPP_IMAGE}",
      "source": {
        "repository": "https://github.com/Hartmannlight/Labeldrucker",
        "revision": "${PLATFORM_SOURCE_REVISION}"
      }
    },
    "postgres": {
      "image": "${POSTGRES_IMAGE}",
      "source": {"kind": "upstream"}
    },
    "printHub": {
      "image": "${PRINTHUB_IMAGE}",
      "source": {
        "repository": "https://github.com/Hartmannlight/PrintHub-ZPL-ll",
        "revision": "${PRINTHUB_SOURCE_REVISION}"
      }
    },
    "printerFleet": {
      "image": "${PRINTER_FLEET_IMAGE}",
      "source": {
        "repository": "https://github.com/Hartmannlight/Labeldrucker",
        "revision": "${PLATFORM_SOURCE_REVISION}"
      }
    },
    "fleetConsole": {
      "image": "${PRINTER_FLEET_CONSOLE_IMAGE}",
      "source": {
        "repository": "https://github.com/Hartmannlight/Labeldrucker",
        "revision": "${PLATFORM_SOURCE_REVISION}"
      }
    },
    "studio": {
      "image": "${PRINTHUB_STUDIO_IMAGE}",
      "source": {
        "repository": "https://github.com/Hartmannlight/LabelArchitect",
        "revision": "${STUDIO_SOURCE_REVISION}"
      }
    },
    "thingdex": {
      "image": "${THINGDEX_IMAGE}",
      "source": {
        "repository": "https://github.com/Hartmannlight/Thingdex",
        "revision": "${THINGDEX_SOURCE_REVISION}"
      }
    }
  }
}
