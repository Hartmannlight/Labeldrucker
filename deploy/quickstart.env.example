# Generated by the future Pi setup command. These example values let
# `docker compose config` validate, but must not be used on a shared network.
COMPOSE_PROJECT_NAME=printhub
PRINTHUB_FLEET_API_TOKEN=replace-with-a-random-service-token
PRINTER_FLEET_ADMIN_TOKEN=replace-with-a-random-operator-token

PRINTHUB_API_BIND=127.0.0.1
PRINTHUB_API_PORT=8001
PRINTHUB_STUDIO_BIND=0.0.0.0
PRINTHUB_STUDIO_PORT=8088
PRINTER_FLEET_CONSOLE_BIND=0.0.0.0
PRINTER_FLEET_CONSOLE_PORT=8089
PRINTHUB_PUBLIC_HOST=printhub.local

# Enable the `ipp` profile only after this Fleet printer ID exists.
PRINTHUB_IPP_PRINTER_ID=replace-with-the-fleet-printer-id
PRINTHUB_MAX_LABELS_PER_JOB=25
PRINTHUB_IPP_NAME=PrintHub Label Printer
PRINTHUB_IPP_ADVERTISED_HOST=printhub.local
PRINTHUB_IPP_PORT=8631

# Required only for the `usb-agent` profile. The setup command creates this
# untracked file and installs a matching host udev rule.
PRINT_AGENT_CONFIG_SOURCE=./state/print-agent.toml
PRINT_AGENT_UID=999
PRINT_AGENT_USB_GID=999
PRINT_AGENT_PORT=8090
PRINTER_FLEET_AGENT_URLS=http://print-agent:8080
PRINTER_FLEET_MEDIA_MISMATCH_TOLERANCE_MM=1.0

TZ=Europe/Berlin
