listen = "0.0.0.0:8080"
data_dir = "/var/lib/zpl-agent"
storage_mode = "full"
agent_id = "replace-with-a-stable-site-id"
# Generate a private random value with at least 24 characters. It protects the
# typed configuration APIs; keep the whole agent on a trusted network as well.
admin_token = "replace-with-a-random-private-admin-token"
webui_enabled = false
mdns_enabled = false
poll_interval_secs = 30
capability_poll_interval_secs = 3600
host_boot_loss_labels = 0
printer_reconnect_loss_labels = 0
calibration_loss_labels = 0
reconnect_debounce_secs = 5
hardware_counters = "disabled"

[[printers]]
id = "usb-zebra"
display_name = "USB Zebra"
device = ""
transport = "usb_bulk"
driver = "zpl"
model_hint = "Replace with the verified model"
# Use decimal USB descriptor values. Never omit usb_serial when more than one
# device with the same vendor/product pair can be attached.
usb_vendor_id = 0
usb_product_id = 0
usb_serial = "replace-with-the-exact-usb-serial"
first_byte_timeout_ms = 5000
idle_timeout_ms = 500
write_timeout_ms = 30000

[printers.device_profile]
resolution_dpi = 203
max_width_dots = 448
max_length_dots = 7917
max_speed_ips = 4
max_offset_dots = 64
thermal_transfer = false
peel_off = false
cutter = false
