# Optional instance name when multiple installations share one Docker host.
COMPOSE_PROJECT_NAME=printhub

# Published multi-architecture defaults are used when these values are omitted.
# Pin immutable sha-* tags or digests for controlled production rollouts.
# ZEBRATAMER_IMAGE=ghcr.io/hartmannlight/zebratamer:latest
# PRINTHUB_IMAGE=ghcr.io/hartmannlight/printhub:latest
# PRINTHUB_STUDIO_IMAGE=ghcr.io/hartmannlight/printhub-studio:latest
# PRINTHUB_IPP_IMAGE=ghcr.io/hartmannlight/printhub-ipp:latest

# Single-PC defaults. Use 0.0.0.0 only on a trusted LAN and put TLS/authentication
# in front of the exposed UI/API.
PRINTHUB_STUDIO_BIND=127.0.0.1
PRINTHUB_STUDIO_PORT=8088
PRINTHUB_API_BIND=127.0.0.1
PRINTHUB_API_PORT=8001
ZEBRATAMER_BIND=127.0.0.1
ZEBRATAMER_PORT=8082

# Empty means that the user selects a printer in Studio.
ZPLGRID_DEFAULT_PRINTER_ID=
PRINTHUB_MAX_LABELS_PER_JOB=25

# Labelary is required only for ZPL preview and template-to-raster conversion.
ZPLGRID_ENABLE_LABELARY_API=0
ZPLGRID_ENABLE_LABELARY_PREVIEW=0
ZPLGRID_ENABLE_LABELARY_TEMPLATES=0

# IPP starts with zero shares; each enabled share receives a stable port in
# 8631-8650 and uses /ipp/print.
PRINTHUB_IPP_BIND=127.0.0.1
PRINTHUB_IPP_HOSTNAME=localhost
PRINTHUB_IPP_MISMATCH_POLICY=hold
PRINTHUB_IPP_MAX_PAGES=100

# Optional development profile.
VIRTUAL_ZEBRA_WEB_BIND=127.0.0.1
VIRTUAL_ZEBRA_WEB_PORT=9191
VIRTUAL_ZEBRA_LABEL_WIDTH_IN=1.9685
VIRTUAL_ZEBRA_LABEL_HEIGHT_IN=0.9843

# Optional second ZebraTamer instance from compose.usb.yaml on a Linux host.
# ZEBRATAMER_USB_DEVICE=/dev/zebra/by-id/my-printer
# ZEBRATAMER_USB_CONFIG_PATH=./config/zebratamer.usb.toml

TZ=Europe/Berlin
