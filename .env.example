# Browser/UI ports
PRINTHUB_STUDIO_PORT=8088
PRINTHUB_API_PORT=8001
VIRTUAL_ZEBRA_WEB_PORT=9191

# Add physical ZebraTamer agents as comma-separated URLs, for example:
# ZPLGRID_ZEBRA_TAMER_AGENTS=http://virtual-zebra:8080,http://192.168.1.50:8080
ZPLGRID_ZEBRA_TAMER_AGENTS=

# Public printer ID = <ZebraTamer agent_id>--<local printer_id>
ZPLGRID_DEFAULT_PRINTER_ID=virtual-zebra

# Optional PNG previews through Labelary. Printing itself does not need these.
ZPLGRID_ENABLE_LABELARY_API=1
ZPLGRID_ENABLE_LABELARY_PREVIEW=1
ZPLGRID_ENABLE_LABELARY_TEMPLATES=1

TZ=Europe/Berlin
