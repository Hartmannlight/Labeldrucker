# Docker project name. Change it when multiple independent stacks share a host.
COMPOSE_PROJECT_NAME=printhub-only

# Host bindings and browser/UI ports. Keep 127.0.0.1 for a single-PC setup.
PRINTHUB_STUDIO_BIND=127.0.0.1
PRINTHUB_STUDIO_PORT=8088
PRINTHUB_API_BIND=127.0.0.1
PRINTHUB_API_PORT=8001
PRINTER_FLEET_CONSOLE_PORT=8089
PRINTER_FLEET_CONSOLE_BIND=127.0.0.1
PRINTER_FLEET_CONSOLE_PUBLIC_URL=http://localhost:8089
VIRTUAL_ZEBRA_WEB_BIND=127.0.0.1
VIRTUAL_ZEBRA_WEB_PORT=9191

# Development-emulator media. Inches are required by the emulator.
# Keep these values aligned with config/printers.yml.
VIRTUAL_ZEBRA_LABEL_WIDTH_IN=1.9685
VIRTUAL_ZEBRA_LABEL_HEIGHT_IN=1.9685

# Driverless IPP/CUPS queue. Defaults are safe for CUPS on this host.
# For access from another machine, set BIND=0.0.0.0 and HOSTNAME to a
# client-resolvable DNS name for this Docker host.
PRINTHUB_IPP_PORT=8631
PRINTHUB_IPP_BIND=127.0.0.1
PRINTHUB_IPP_HOSTNAME=localhost
PRINTHUB_IPP_PRINTER_ID=virtual-zebra
PRINTHUB_IPP_NAME=PrintHub Label Printer
# hold prevents accidental A4 -> label printing; fit/fill opt into scaling.
PRINTHUB_IPP_MISMATCH_POLICY=hold
PRINTHUB_IPP_MAX_PAGES=100

# Add PrintAgents as comma-separated URLs, for example:
# PRINTER_FLEET_AGENT_URLS=http://192.168.1.50:8080
PRINTER_FLEET_AGENT_URLS=

# Required only with compose.usb-agent.yaml. Docker must be able to see this
# exact Linux device node. It can change after reconnecting the USB cable.
# PRINT_AGENT_USB_DEVICE=/dev/bus/usb/001/002
# PRINT_AGENT_CONFIG_PATH=./deploy/secrets/print-agent-usb.toml

# Existing public IDs survive migration; new IDs are returned by registration.
ZPLGRID_DEFAULT_PRINTER_ID=virtual-zebra
PRINTER_FLEET_DISCOVERY_INTERVAL_SECONDS=30

# Development-only scoped credentials. Use mounted secret files in production.
PRINTHUB_FLEET_API_TOKEN=development-printhub-token
PRINTER_FLEET_ADMIN_TOKEN=development-fleet-admin-token

# Optional PNG previews through Labelary. Printing itself does not need these.
ZPLGRID_ENABLE_LABELARY_API=1
ZPLGRID_ENABLE_LABELARY_PREVIEW=1
ZPLGRID_ENABLE_LABELARY_TEMPLATES=1

TZ=Europe/Berlin
